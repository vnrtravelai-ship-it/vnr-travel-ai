rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() 
        && 'email' in request.auth.token 
        && request.auth.token.email == "vnrtravelai@gmail.com";
    }

    function incoming() {
      return request.resource.data;
    }

    // Default deny secure gate
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Users profiles: public READ, owner can create/update, admin can read/update all profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Secured Sub-collection for isolated PII
      match /private/info {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Users private info sub-collection (explicit check)
    match /users/{userId}/private/info {
      allow read, write: if isOwner(userId);
    }

    // 3. Itineraries: owner CRUD, admin read
    match /itineraries/{itineraryId} {
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid);
      allow read: if (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
      allow update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // 4. Affiliate clicks: authenticated create, admin read, no update/delete
    match /affiliateClicks/{clickId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /affiliate_clicks/{clickId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // 5. Forum (posts, comments, likes): authenticated create, public read, owner delete
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().authorId == request.auth.uid);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().authorId == request.auth.uid);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || incoming().authorId == request.auth.uid);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 6. Admin CRM Audit Logs
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 7. Audit Logs general match
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // 8. Crashes / Error logs
    match /crashes/{crashId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}
