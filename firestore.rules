rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email == "vnrtravelai@gmail.com";
    }

    function incoming() {
      return request.resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /private/info {
        allow read, write: if isOwner(userId);
      }
    }

    match /users/{userId}/private/info {
      allow read, write: if isOwner(userId);
    }

    // =========================
    // ITINERARIES
    // =========================

    match /itineraries/{itineraryId} {
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid;

      allow read: if isAdmin()
        || (isSignedIn()
        && resource.data.userId == request.auth.uid);

      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // =========================
    // LEADS
    // =========================

    match /leads/{leadId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================
    // CLICKS
    // =========================

    match /clicks/{clickId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // =========================
    // AFFILIATE CLICKS
    // =========================

    match /affiliateClicks/{clickId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /affiliate_clicks/{clickId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // =========================
    // POSTS
    // =========================

    match /posts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && (
          incoming().userId == request.auth.uid
          || incoming().authorId == request.auth.uid
        );

      allow update: if isSignedIn();

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.authorId == request.auth.uid
          )
        );
    }

    // =========================
    // COMMENTS
    // =========================

    match /comments/{commentId} {

      allow read: if true;

      allow create: if isSignedIn()
        && (
          incoming().userId == request.auth.uid
          || incoming().authorId == request.auth.uid
        );

      allow update: if isSignedIn();

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.authorId == request.auth.uid
          )
        );
    }

    // =========================
    // LIKES
    // =========================

    match /likes/{likeId} {

      allow read: if true;

      allow create: if isSignedIn()
        && (
          incoming().userId == request.auth.uid
          || incoming().authorId == request.auth.uid
        );

      allow update: if isSignedIn();

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.authorId == request.auth.uid
          )
        );
    }

    // =========================
    // OBSERVABILITY LOGS
    // =========================

    match /observability_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // =========================
    // ADMIN LOGS
    // =========================

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // CRASH REPORTS
    // =========================

    match /crashes/{crashId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

  }
}